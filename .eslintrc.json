{
  "env": {
    "node": true, // Enables Node.js global variables and Node.js scoping
    "es2021": true // Enables modern ES2021 features
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 12, // Parses modern ECMAScript features (same as 2021)
    "sourceType": "module" // Allows use of ES Modules (import/export)
  },
  "rules": {
    "prettier/prettier": "error", // Ensures Prettier rules are enforced
    "no-undef": "off" // Disables undefined variable warnings (for this issue)
  }
}
